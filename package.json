{
  "name": "bloom-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json --pretty false && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false && tsc -p tsconfig.functions.json --pretty false",
    "test": "tsx --test tests/domain*.test.ts",
    "cf:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "wrangler": "^4.149.0"
  }
}
