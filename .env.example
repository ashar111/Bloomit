# Vite build-time setting. Keep empty for local browser-only mode.
# Cloudflare Pages production: set to /api to enable server-side Supabase persistence.
VITE_API_BASE_URL=/api

# These are Cloudflare Pages Function secrets, not Vite variables.
# Set them in Cloudflare Dashboard → Pages → Settings → Environment variables.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# ALLOWED_ORIGIN=https://YOUR_PAGES_DOMAIN.pages.dev
# TURNSTILE_SECRET_KEY=optional-server-only-secret
